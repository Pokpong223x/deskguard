{
  "cli": { "version": ">= 16.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "ios": { "simulator": false }
    },
    "sideload": {
      "distribution": "internal",
      "developmentClient": false,
      "node": "24.12.0",
      "ios": {
        "simulator": false,
        "withoutCredentials": true,
        "resourceClass": "medium",
        "buildConfiguration": "Release",
        "config": "ios-unsigned.yml"
      }
    }
  }
}
